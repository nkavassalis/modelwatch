# modelwatch publish — runs every 3 hours; the app itself skips the fetch/upload
# unless the configured cache_ttl_hours has expired. Keep the cron interval at
# or below the TTL so the cron schedule is what actually sets the fetch cadence
# (here: 3h cron + 3h TTL = a new leaderboard check every 3 hours).
# Adjust paths and venv location to your install.
0 */3 * * * cd /home/nick/modelWatch && /home/nick/modelWatch/.venv/bin/python -m modelwatch publish --config /home/nick/modelWatch/config.yml >> /home/nick/modelWatch/publish.log 2>&1
